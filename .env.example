# ==============================================================================
# NEXUS Environment Configuration
# Copy this file to .env and fill in the required values.
# Never commit .env or any real API keys to git.
# ==============================================================================

# --- Server -------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# Comma-separated list of allowed browser origins for CSRF/WebSocket checks.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set to true when serving over HTTPS so session cookies have the Secure flag.
COOKIE_SECURE=false

# --- Database (Neon Postgres) -------------------------------------------------
# Put your Neon Postgres connection string here (must include sslmode=require).
# Use the DIRECT (non-pooler) Neon URL when running `npm run migrate`.
# The pooled Neon URL is fine for running the server and worker.
# For offline local development with docker-compose (`--profile local-db`), use:
#   DATABASE_URL=postgres://nexus:nexus@127.0.0.1:5432/nexus
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Redis (BullMQ job queue & pub/sub) ---------------------------------------
# Local Docker Redis or Upstash TCP/TLS URL (e.g. rediss://default:pass@host:6379).
REDIS_URL=redis://127.0.0.1:6379
# Key prefix for BullMQ queues in Redis.
NEXUS_QUEUE_PREFIX=nexus

# --- Encryption ---------------------------------------------------------------
# Required. 32-byte key, base64-encoded. Encrypts provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
NEXUS_MASTER_KEY=

# --- Runtime & Orchestrator ---------------------------------------------------
# Directory for project workspaces and sandbox assets (resolved relative to apps/server if relative).
NEXUS_DATA_DIR=../../data
# Run the BullMQ worker inside the API server process. Set to false when scaling workers separately.
NEXUS_RUN_WORKER=true
# Number of concurrent agent task jobs per worker process.
NEXUS_WORKER_CONCURRENCY=4
# Default mission budget cap in USD when not specified by the CEO.
NEXUS_DEFAULT_BUDGET_USD=5

# --- Sandboxes (Docker) -------------------------------------------------------
# Container image for agent execution sandboxes (FORGE). No network access.
SANDBOX_EXEC_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
# Container image for SCOUT's isolated Chromium browser sandbox.
SANDBOX_BROWSER_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
# Per-container resource limits for exec sandboxes.
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256
# Default command timeout (ms) and stdout/stderr capture cap (bytes).
SANDBOX_EXEC_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT_BYTES=64000
# Non-root UID:GID inside exec containers (matches host user on Linux).
SANDBOX_UID=1000:1000
# Dedicated Docker bridge network for browser sandboxes.
SANDBOX_BROWSER_NETWORK=nexus-browser
# Path to sandbox/browser-worker mounted read-only into browser containers.
SANDBOX_BROWSER_WORKER_DIR=../../sandbox/browser-worker
# Timeout (ms) for browser navigation / search / screenshot calls.
SANDBOX_BROWSER_TIMEOUT_MS=45000
# Optional PEM file of an extra CA to trust inside Chromium (only behind a TLS-inspecting proxy).
# Never disable TLS verification. Leave empty unless required.
SANDBOX_EXTRA_CA_FILE=

# --- Egress Gateway (Browser Proxy) -------------------------------------------
# Port on the browser Docker bridge gateway IP where the egress proxy listens.
EGRESS_PORT=3128
# Optional upstream HTTP CONNECT proxy for the egress gateway (defaults to HTTPS_PROXY).
EGRESS_UPSTREAM_PROXY=
# Optional comma-separated domain allowlist (empty = allow all public domains not on deny list).
EGRESS_ALLOW=
# Comma-separated domain/IP denylist (private/loopback/link-local IPs are always blocked).
EGRESS_DENY=metadata.google.internal,169.254.169.254

# --- Web Frontend (Next.js) ---------------------------------------------------
# Backend API origin used by Next.js rewrites for /api/* and /preview/*.
API_URL=http://127.0.0.1:4000
# WebSocket origin used by the browser to connect to /api/ws.
NEXT_PUBLIC_WS_ORIGIN=ws://127.0.0.1:4000

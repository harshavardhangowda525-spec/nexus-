{
  "name": "@nexus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker-main.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/websocket": "11.0.2",
    "@nexus/shared": "0.1.0",
    "bullmq": "5.41.7",
    "e2b": "2.64.0",
    "fastify": "5.2.1",
    "ioredis": "5.6.0",
    "pg": "8.13.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/ws": "8.5.14",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.9",
    "ws": "8.18.1"
  }
}
